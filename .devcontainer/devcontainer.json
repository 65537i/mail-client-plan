{
  "name": "mail-client",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "remoteUser": "node",
  "postCreateCommand": "pnpm install --frozen-lockfile",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "Vue.volar",
        "GitHub.vscode-pull-request-github",
        "github.vscode-github-actions",
        "timonwong.shellcheck",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
